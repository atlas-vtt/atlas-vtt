{
  "name": "atlas-vtt",
  "version": "0.13.2-beta.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "cross-env COPY_ON_CHANGE=true vite build --watch",
    "obsidian": "node scripts/obsidian-cli.js",
    "obsidian:help": "node scripts/obsidian-cli.js help",
    "obsidian:print-bin": "node scripts/obsidian-cli.js --print-bin",
    "obsidian:reload": "node scripts/obsidian-cli.js plugin:reload id=atlas-vtt",
    "obsidian:errors": "node scripts/obsidian-cli.js dev:errors",
    "obsidian:console": "node scripts/obsidian-cli.js dev:console",
    "build": "cross-env COPY_ON_CHANGE=false vite build",
    "build:ci": "cross-env COPY_ON_CHANGE=false vite build",
    "postbuild": "node scripts/copy-plugin.js",
    "test": "vitest --project unit",
    "test:slow": "vitest run --project slow",
    "test:gpu": "vitest run --project gpu",
    "test:caves": "vitest run --project slow tests/unit/dungeons/cave/ tests/unit/dungeons/caveInvariants.floors1.test.ts tests/unit/dungeons/caveInvariants.floors2.test.ts tests/unit/dungeons/caveInvariants.floors3.test.ts tests/unit/dungeons/levelLinkAccess.cavern.test.ts tests/unit/dungeons/walkedStairwells.test.ts tests/unit/dungeons/otherThemesUntouched.test.ts tests/unit/dungeons/themeTagEffects.test.ts tests/unit/dungeons/createDungeonScene.test.ts tests/unit/dungeons/dungeonSceneParts.test.ts tests/unit/dungeons/sceneWalls.test.ts tests/unit/dungeons/dungeonLiquids.test.ts tests/unit/dungeons/generateInvariants.floors1.test.ts tests/unit/dungeons/generateInvariants.floors2.test.ts",
    "test:dungeons": "vitest run --project slow tests/unit/dungeons/ tests/unit/dungeonWizard.test.tsx",
    "test:perf": "vitest run --project perf",
    "changelog:generate": "node scripts/changelog.js",
    "changelog:check": "node scripts/changelog.js --check",
    "release:prepare": "node scripts/prepare-release-assets.js",
    "release:validate": "node scripts/prepare-release-assets.js --validate-only",
    "version": "node scripts/sync-version.js && git add manifest.json versions.json CHANGELOG.md src/app/changelog/releases.json",
    "version:check": "node scripts/release-channel.js",
    "lint": "eslint . --max-warnings 0 --suppressions-location eslint.suppressions.json",
    "lint:scan": "node scripts/lint-scan.js",
    "preflight": "node scripts/preflight.js",
    "check:boundaries": "node scripts/check-boundaries.mjs && tsc -p tsconfig.shared.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vtt",
    "ttrpg",
    "battle-map"
  ],
  "author": "Fabian Urbanek",
  "license": "AGPL-3.0-only",
  "description": "Virtual tabletop for tabletop RPGs inside Obsidian.",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.24",
    "clipper2-ts": "2.0.1-18",
    "clsx": "^2.1.1",
    "framer-motion": "^12.7.4",
    "howler": "^2.2.4",
    "immer": "11.2.9",
    "jszip": "^3.10.2",
    "lucide-react": "^0.503.0",
    "pixi-filters": "^6.1.5",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "tslib": "2.8.1",
    "uqr": "0.1.3",
    "yaml": "^2.9.1",
    "zundo": "^2.3.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@testing-library/react": "16.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser-playwright": "5.1.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "4.10.2",
    "jsdom": "^26.1.0",
    "obsidian": "^1.14.4",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "postcss-nesting": "^14.0.3",
    "sass": "^1.107.0",
    "tailwindcss": "^3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteMirror/atlas-vtt.git"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7",
    "moment": "^2.31.0"
  }
}
