{
  "name": "atlas-vtt",
  "version": "0.6.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "cross-env COPY_ON_CHANGE=true vite build --watch",
    "obsidian": "node scripts/obsidian-cli.js",
    "obsidian:help": "node scripts/obsidian-cli.js help",
    "obsidian:print-bin": "node scripts/obsidian-cli.js --print-bin",
    "obsidian:reload": "node scripts/obsidian-cli.js plugin:reload id=atlas-vtt",
    "obsidian:errors": "node scripts/obsidian-cli.js dev:errors",
    "obsidian:console": "node scripts/obsidian-cli.js dev:console",
    "build": "cross-env COPY_ON_CHANGE=false vite build",
    "build:ci": "cross-env COPY_ON_CHANGE=false vite build",
    "postbuild": "node scripts/copy-plugin.js",
    "test": "vitest --project unit",
    "test:gpu": "vitest run --project gpu",
    "changelog:generate": "node scripts/changelog.js",
    "changelog:check": "node scripts/changelog.js --check",
    "release:prepare": "node scripts/prepare-release-assets.js",
    "release:validate": "node scripts/prepare-release-assets.js --validate-only",
    "version": "node scripts/sync-version.js && git add manifest.json versions.json CHANGELOG.md src/app/changelog/releases.json",
    "version:check": "node scripts/release-channel.js",
    "lint": "eslint . --max-warnings 0 --suppressions-location eslint.suppressions.json",
    "lint:scan": "node scripts/lint-scan.js",
    "preflight": "node scripts/preflight.js"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vtt",
    "ttrpg",
    "battle-map"
  ],
  "author": "Fabian Urbanek",
  "license": "AGPL-3.0-only",
  "description": "Virtual tabletop for tabletop RPGs inside Obsidian.",
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "framer-motion": "^12.7.4",
    "howler": "^2.2.4",
    "immer": "11.1.18",
    "jszip": "^3.10.1",
    "lucide-react": "^0.503.0",
    "pixi-filters": "^6.1.2",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.21.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.2.0",
    "three": "^0.185.1",
    "tslib": "2.8.1",
    "zundo": "^2.3.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@testing-library/react": "16.3.0",
    "@types/howler": "^2.2.12",
    "@types/node": "26.6.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser-playwright": "4.1.11",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "esbuild": "0.25.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.1.0",
    "obsidian": "^1.13.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.3",
    "postcss-nesting": "^13.0.1",
    "sass": "^1.87.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteMirror/atlas-vtt.git"
  },
  "engines": {
    "node": ">=22"
  }
}
